#!/bin/bash
# Environment setup for CBMC and CBMC-GC-2
# Source this file to load required modules and update PATH

# Load required modules
module purge
module load gcc/14.2.0
module load cmake/3.30.5
module load anaconda/2025.06-py313

# Set installation directories (matching install_cluster_bell_c_boundle.sh)
CBMC_PREFIX_DIR="/tmp/are_env/CBMC/prefix"
CBMC_MODULE_DIR="/tmp/are_env/CBMC/build"
CBMC_GC2_PREFIX_DIR="/tmp/are_env/CBMC-GC-2/prefix"
CBMC_GC2_MODULE_DIR="/tmp/are_env/CBMC-GC-2/build"

# Update PATH to include CBMC and CBMC-GC-2 binaries
export PATH="${CBMC_GC2_MODULE_DIR}/bin:${CBMC_GC2_PREFIX_DIR}/bin:${CBMC_MODULE_DIR}/bin:${CBMC_PREFIX_DIR}/bin:${PATH}"

# Verify installations (only report if missing)
if ! command -v cbmc >/dev/null 2>&1; then
    echo "Warning: cbmc not found in PATH"
fi

if ! command -v cbmc-gc >/dev/null 2>&1; then
    echo "Warning: cbmc-gc not found in PATH"
fi
